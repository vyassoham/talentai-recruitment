# ==============================================================================
# Antigravity AI Recruitment Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or backend/.env and populate with your environment secrets.

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://recruit_admin:recruit_password@localhost:5433/recruit_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# ------------------------------------------------------------------------------
# 2. Distributed Task Queue (Celery / Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Options: "local" (in-memory daemon threads) or "celery" / "redis" (distributed workers)
QUEUE_BACKEND=local

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT & RBAC)
# ------------------------------------------------------------------------------
# In production, generate a secure secret: openssl rand -hex 32
SECRET_KEY=temporary-secret-do-not-use-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 4. AI Provider & Large Language Models
# ------------------------------------------------------------------------------
# Options: "openai" (live GPT-4o) or "mock" (offline deterministic testing)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. Search, Ranking & Concurrency Tuning
# ------------------------------------------------------------------------------
RETRIEVAL_WEIGHT_SKILL=0.4
RETRIEVAL_WEIGHT_SEMANTIC=0.3
RETRIEVAL_WEIGHT_EXPERIENCE=0.2
RETRIEVAL_WEIGHT_PREFERRED=0.1
RETRIEVAL_TOP_K=200
RERANK_TOP_N=10
RERANK_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 6. Document Storage & Cloud Providers
# ------------------------------------------------------------------------------
# Options: "local", "s3", or "gcs"
STORAGE_BACKEND=local
MAX_CV_FILE_SIZE_MB=10
ALLOWED_CV_EXTENSIONS=[".pdf",".docx"]

# AWS S3 (Required if STORAGE_BACKEND=s3)
S3_BUCKET_NAME=recruitment-cv-storage
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage (Required if STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=recruitment-cv-bucket

# ------------------------------------------------------------------------------
# 7. Antivirus & Malware Scanning (ClamAV Daemon)
# ------------------------------------------------------------------------------
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
